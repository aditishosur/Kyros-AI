{
    "model_name": "RandomForestClassifier",

    "features": [
        "latency",
        "error_rate",
        "traffic",
        "downtime"
    ],

    "risk_classes": [
        "Low",
        "Medium",
        "High"
    ],

    "sample_inputs": [
        {
            "api": "User Authentication",
            "latency": 120,
            "error_rate": 0.01,
            "traffic": 5000,
            "downtime": 0
        },

        {
            "api": "Payment Service",
            "latency": 800,
            "error_rate": 0.25,
            "traffic": 9000,
            "downtime": 15
        }
    ],

    "prediction": {
        "risk_score": 82,
        "risk_level": "High"
    }
}